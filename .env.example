# Copy to .env and fill in. Never commit .env.
#
# For `docker compose up` you only need these four. Compose sets the database
# and MCP addresses itself — see docker-compose.yml.

# 1. Your OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# 2. Shared secret the MCP server requires from its clients.
#    python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# 3. Signs the short-lived browser tokens. A DIFFERENT value from API_TOKEN:
#    one is a bearer credential clients present, the other a signing key only
#    the server uses. Reuse them and a leak of either compromises both.
#    python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=


# ── Only needed when running on the host instead of in Docker ──────────────
# DATABASE_URL=postgresql://ops_reader:reader_dev_password@localhost:5434/chargeops
# MCP_URL=http://127.0.0.1:8765/mcp
